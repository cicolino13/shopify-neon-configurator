{%- comment -%}
  Self-hosted replacements for the Google Fonts previously loaded via
  fonts.googleapis.com / fonts.gstatic.com (Syne site-wide, plus
  Pacifico/Baloo 2/Monoton/Bungee/IBM Plex Mono for the neon configurator).
  Serving the font files from Shopify's own CDN avoids sending visitor
  IP addresses to Google on every page load.
{%- endcomment -%}
{%- style -%}
  @font-face {
    font-family: 'Syne';
    font-style: normal;
    font-weight: 600 700;
    font-display: swap;
    src: url('https://cdn.shopify.com/s/files/1/0943/7203/6947/files/syne-latin-ext.woff2?v=1787911502') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
