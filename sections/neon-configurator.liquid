{% schema %}
{
  "name": "Neon configurator",
  "settings": [],
  "presets": [{ "name": "Neon" }]
}
{% endschema %}
{{ 'neon-configurator.css' | asset_url | stylesheet_tag }}

{% assign nlc_start_step = 1 %}
{% if form.posted_successfully? or form.errors %}
  {% assign nlc_start_step = 2 %}
{% endif %}

<div class="nlc-wrap" id="konfigurator" data-start-step="{{ nlc_start_step }}">
  <div class="nlc-intro">
    <span class="nlc-eyebrow">Live-Vorschau</span>
    <h2 class="nlc-heading">Gestalte dein Neon-Sign</h2>
    <p class="nlc-sub">Text, Stil, Farbe, Größe, Montage und Hintergrund wählen &ndash; wir senden dir innerhalb von 24&nbsp;Stunden ein persönliches Angebot per E-Mail, mit dem du direkt online bestellen kannst.</p>
  </div>

  <div class="nlc-tool">
    <div class="nlc-stage-col">
      <div class="nlc-stage" id="nlcStage-{{ section.id }}">
        <div class="nlc-ambient" id="nlcAmbient-{{ section.id }}"></div>
        <div class="nlc-board">
          <span class="nlc-preview" id="nlcPreview-{{ section.id }}" style="--nlc-color:#ffb340; --nlc-core-color:#ffe1b3; --nlc-scale:1; --nlc-glow:0.5; font-family:'Monoton', cursive;">NEONLIGHT</span>
          <img class="nlc-logo-preview" id="nlcLogoPreview-{{ section.id }}" alt="" hidden>
        </div>
      </div>
      <div class="nlc-scenes" role="radiogroup" aria-label="Hintergrund wählen" id="nlcScenes-{{ section.id }}">
        <button type="button" class="nlc-scene is-active" data-bg="https://cdn.shopify.com/s/files/1/0943/7203/6947/files/hecke-hintergrund.jpg?width=1600" data-name="Hecke" role="radio" aria-checked="true">
          <span class="nlc-scene-swatch" style="background-image:url('https://cdn.shopify.com/s/files/1/0943/7203/6947/files/hecke-hintergrund.jpg?width=200');"></span>Hecke
        </button>
        <button type="button" class="nlc-scene" data-bg="https://cdn.shopify.com/s/files/1/0943/7203/6947/files/wohnzimmer-hintergrund-v5.jpg?width=1600" data-name="Wohnzimmer" role="radio" aria-checked="false">
          <span class="nlc-scene-swatch" style="background-image:url('https://cdn.shopify.com/s/files/1/0943/7203/6947/files/wohnzimmer-hintergrund-v5.jpg?width=200');"></span>Wohnzimmer
        </button>
        <button type="button" class="nlc-scene" data-bg="https://cdn.shopify.com/s/files/1/0943/7203/6947/files/backstein-hintergrund.jpg?width=1600" data-name="Backstein" role="radio" aria-checked="false">
          <span class="nlc-scene-swatch" style="background-image:url('https://cdn.shopify.com/s/files/1/0943/7203/6947/files/backstein-hintergrund.jpg?width=200');"></span>Backstein
        </button>
        <button type="button" class="nlc-scene" data-bg="https://cdn.shopify.com/s/files/1/0943/7203/6947/files/bar-hintergrund-neu.jpg?width=1600" data-name="Bar &amp; Restaurant" role="radio" aria-checked="false">
          <span class="nlc-scene-swatch" style="background-image:url('https://cdn.shopify.com/s/files/1/0943/7203/6947/files/bar-hintergrund-neu.jpg?width=200');"></span>Bar
        </button>
      </div>
    </div>

    <div class="nlc-controls">
      <div class="nlc-stepper" id="nlcStepper-{{ section.id }}" aria-hidden="true">
        <span class="nlc-step-dot" data-step-dot="1">1</span>
        <span class="nlc-step-label" data-step-label="1">Gestalten</span>
        <span class="nlc-step-line"></span>
        <span class="nlc-step-dot" data-step-dot="2">2</span>
        <span class="nlc-step-label" data-step-label="2">Kontakt</span>
      </div>
      <p class="visually-hidden" role="status" aria-live="polite" id="nlcStepAnnounce-{{ section.id }}"></p>

      <div class="nlc-step" data-step="1" id="nlcStep1-{{ section.id }}">
        <label class="nlc-field" for="nlcText-{{ section.id }}">
          <span class="nlc-label">Dein Text</span>
          <input type="text" id="nlcText-{{ section.id }}" maxlength="20" value="NEONLIGHT" placeholder="z. B. Café Nova" autocomplete="off">
        </label>

        <div class="nlc-field">
          <span class="nlc-label">Logo (optional)</span>
          <div class="nlc-upload" id="nlcUpload-{{ section.id }}">
            <input type="file" id="nlcLogoInput-{{ section.id }}" class="visually-hidden" accept="image/png,image/jpeg,image/svg+xml,application/pdf">
            <label for="nlcLogoInput-{{ section.id }}" class="nlc-upload-btn">Logo hochladen</label>
            <img class="nlc-upload-thumb" id="nlcUploadThumb-{{ section.id }}" alt="" hidden>
            <span class="nlc-upload-status" id="nlcUploadStatus-{{ section.id }}">Kein Logo ausgewählt</span>
          </div>
        </div>

        <div class="nlc-field">
          <span class="nlc-label">Stil</span>
          <div class="nlc-styles" role="radiogroup" aria-label="Schriftstil wählen" id="nlcStyles-{{ section.id }}">
            <button type="button" class="nlc-style" data-font="'Syne', sans-serif" data-name="Modern" data-glow="1" role="radio" aria-checked="false" style="font-family:'Syne', sans-serif;">Modern</button>
            <button type="button" class="nlc-style" data-font="'Great Vibes', cursive" data-name="Elegant" data-glow="0.5" role="radio" aria-checked="false" style="font-family:'Great Vibes', cursive;">Elegant</button>
            <button type="button" class="nlc-style" data-font="'Dancing Script', cursive" data-name="Klassisch" data-glow="0.7" role="radio" aria-checked="false" style="font-family:'Dancing Script', cursive;">Klassisch</button>
            <button type="button" class="nlc-style" data-font="'Pacifico', cursive" data-name="Skript" data-glow="0.7" role="radio" aria-checked="false" style="font-family:'Pacifico', cursive;">Skript</button>
            <button type="button" class="nlc-style" data-font="'Baloo 2', sans-serif" data-name="Rund" data-glow="0.85" role="radio" aria-checked="false" style="font-family:'Baloo 2', sans-serif;">Rund</button>
            <button type="button" class="nlc-style is-active" data-font="'Monoton', cursive" data-name="Retro" data-glow="0.5" role="radio" aria-checked="true" style="font-family:'Monoton', cursive;">Retro</button>
            <button type="button" class="nlc-style" data-font="'Bungee', cursive" data-name="Urban" data-glow="0.85" role="radio" aria-checked="false" style="font-family:'Bungee', cursive;">Urban</button>
          </div>
        </div>

        <div class="nlc-field">
          <div class="nlc-field-head">
            <span class="nlc-label">Farbe</span>
            <span class="nlc-value" id="nlcColorName-{{ section.id }}">Bernstein</span>
          </div>
          <div class="nlc-swatches" role="radiogroup" aria-label="Neonfarbe wählen" id="nlcSwatches-{{ section.id }}">
            <button type="button" class="nlc-swatch" style="--sw:#3fd7e0" data-color="#3fd7e0" data-name="Cyan" role="radio" aria-checked="false"><span class="visually-hidden">Cyan</span></button>
            <button type="button" class="nlc-swatch" style="--sw:#ff3ea5" data-color="#ff3ea5" data-name="Pink" role="radio" aria-checked="false"><span class="visually-hidden">Pink</span></button>
            <button type="button" class="nlc-swatch" style="--sw:#ffe9c7" data-color="#ffe9c7" data-name="Warmweiss" role="radio" aria-checked="false"><span class="visually-hidden">Warmweiss</span></button>
            <button type="button" class="nlc-swatch" style="--sw:#f5f7ff" data-color="#f5f7ff" data-name="Weiß" role="radio" aria-checked="false"><span class="visually-hidden">Weiß</span></button>
            <button type="button" class="nlc-swatch" style="--sw:#39ff88" data-color="#39ff88" data-name="Grün" role="radio" aria-checked="false"><span class="visually-hidden">Grün</span></button>
            <button type="button" class="nlc-swatch" style="--sw:#ff8a3d" data-color="#ff8a3d" data-name="Orange" role="radio" aria-checked="false"><span class="visually-hidden">Orange</span></button>
            <button type="button" class="nlc-swatch" style="--sw:#3d7bff" data-color="#3d7bff" data-name="Blau" role="radio" aria-checked="false"><span class="visually-hidden">Blau</span></button>
            <button type="button" class="nlc-swatch" style="--sw:#b968ff" data-color="#b968ff" data-name="Lila" role="radio" aria-checked="false"><span class="visually-hidden">Lila</span></button>
            <button type="button" class="nlc-swatch" style="--sw:#ff3b3b" data-color="#ff3b3b" data-name="Rot" role="radio" aria-checked="false"><span class="visually-hidden">Rot</span></button>
            <button type="button" class="nlc-swatch" style="--sw:#ffe14d" data-color="#ffe14d" data-name="Gelb" role="radio" aria-checked="false"><span class="visually-hidden">Gelb</span></button>
            <button type="button" class="nlc-swatch" style="--sw:#1de9b6" data-color="#1de9b6" data-name="Türkis" role="radio" aria-checked="false"><span class="visually-hidden">Türkis</span></button>
            <button type="button" class="nlc-swatch" style="--sw:#8fd9ff" data-color="#8fd9ff" data-name="Eisblau" role="radio" aria-checked="false"><span class="visually-hidden">Eisblau</span></button>
            <button type="button" class="nlc-swatch is-active" style="--sw:#ffb340" data-color="#ffb340" data-name="Bernstein" role="radio" aria-checked="true"><span class="visually-hidden">Bernstein</span></button>
            <button type="button" class="nlc-swatch" style="background:conic-gradient(from 0deg, #ff3b3b, #ffe14d, #39ff88, #3fd7e0, #3d7bff, #b968ff, #ff3ea5, #ff3b3b);" data-color="#ff3b3b" data-name="RGB" data-rgb="true" role="radio" aria-checked="false"><span class="visually-hidden">RGB Farbwechsel</span></button>
          </div>
        </div>

        <div class="nlc-field">
          <span class="nlc-label">Größe</span>
          <div class="nlc-sizes" role="radiogroup" aria-label="Größe wählen" id="nlcSizes-{{ section.id }}">
            <button type="button" class="nlc-size" data-size="S · ca. 30 cm Breite" data-scale="0.7" data-width="30" role="radio" aria-checked="false">S<small>ca. 30 cm</small></button>
            <button type="button" class="nlc-size is-active" data-size="M · ca. 50 cm Breite" data-scale="1" data-width="50" role="radio" aria-checked="true">M<small>ca. 50 cm</small></button>
            <button type="button" class="nlc-size" data-size="L · ca. 80 cm Breite" data-scale="1.35" data-width="80" role="radio" aria-checked="false">L<small>ca. 80 cm</small></button>
            <button type="button" class="nlc-size" data-size="XL · ca. 110 cm Breite" data-scale="1.7" data-width="110" role="radio" aria-checked="false">XL<small>ca. 110 cm</small></button>
            <button type="button" class="nlc-size" data-custom-size="true" role="radio" aria-checked="false">Eigene<small>Masse</small></button>
          </div>
          <div class="nlc-custom-size" id="nlcCustomSize-{{ section.id }}" hidden>
            <label class="nlc-custom-size-label" for="nlcCustomWidth-{{ section.id }}">Breite in cm</label>
            <input type="number" id="nlcCustomWidth-{{ section.id }}" min="10" max="300" step="1" inputmode="numeric" placeholder="z. B. 65">
          </div>
        </div>

        <div class="nlc-field">
          <span class="nlc-label">Rückwand</span>
          <div class="nlc-sizes" role="radiogroup" aria-label="Rückwand wählen" id="nlcBackings-{{ section.id }}">
            <button type="button" class="nlc-size is-active" data-backing="Konturgeschnitten (transparent)" data-backing-key="kontur" role="radio" aria-checked="true">Kontur<small>transparent, unsichtbar</small></button>
            <button type="button" class="nlc-size" data-backing="Rechteckig (transparent)" data-backing-key="transparent" role="radio" aria-checked="false">Rechteckig<small>transparent</small></button>
            <button type="button" class="nlc-size" data-backing="Rechteckig (schwarz)" data-backing-key="schwarz" role="radio" aria-checked="false">Rechteckig<small>schwarz, matt</small></button>
            <button type="button" class="nlc-size" data-backing="Ohne Rückwand" data-backing-key="kontur" role="radio" aria-checked="false">Ohne<small>nur Buchstaben</small></button>
          </div>
        </div>

        <div class="nlc-field">
          <span class="nlc-label">Befestigung</span>
          <div class="nlc-sizes" role="radiogroup" aria-label="Befestigung wählen" id="nlcMounts-{{ section.id }}">
            <button type="button" class="nlc-size is-active" data-mount="Wandmontage mit Abstandshaltern" role="radio" aria-checked="true">Wand<small>Abstandshalter</small></button>
            <button type="button" class="nlc-size" data-mount="Wandmontage flach (Direktmontage)" role="radio" aria-checked="false">Wand flach<small>Direktmontage</small></button>
            <button type="button" class="nlc-size" data-mount="Hängend (Kette/Stahlseil von der Decke)" role="radio" aria-checked="false">Hängend<small>Kette/Seil</small></button>
            <button type="button" class="nlc-size" data-mount="Standfuß (Tischaufsteller)" role="radio" aria-checked="false">Standfuß<small>Tischaufsteller</small></button>
          </div>
        </div>

        <div class="nlc-field">
          <span class="nlc-label">Einsatzort</span>
          <div class="nlc-chips" role="radiogroup" aria-label="Einsatzort wählen" id="nlcEnvs-{{ section.id }}">
            <button type="button" class="nlc-chip is-active" data-env="Innen" role="radio" aria-checked="true">Innen</button>
            <button type="button" class="nlc-chip" data-env="Außen (wetterfest)" role="radio" aria-checked="false">Außen</button>
          </div>
        </div>

        <div class="nlc-field">
          <span class="nlc-label">Zubehör</span>
          <div class="nlc-chips" role="radiogroup" aria-label="Zubehör wählen" id="nlcAccessories-{{ section.id }}">
            <button type="button" class="nlc-chip is-active" data-accessory="Mit Fernbedienung &amp; Dimmer" role="radio" aria-checked="true">Fernbedienung &amp; Dimmer</button>
            <button type="button" class="nlc-chip" data-accessory="Ohne Fernbedienung" role="radio" aria-checked="false">Ohne</button>
          </div>
        </div>

        <p class="nlc-price-estimate" id="nlcPriceEstimate-{{ section.id }}"></p>

        <button type="button" class="nlc-cta button" id="nlcNextBtn-{{ section.id }}">Weiter zur Kontaktanfrage</button>
      </div>

      <div class="nlc-step" data-step="2" id="nlcStep2-{{ section.id }}" hidden>
        <button type="button" class="nlc-back" id="nlcBackBtn-{{ section.id }}">&larr; Zurück zur Gestaltung</button>

        <div class="nlc-recap" id="nlcRecap-{{ section.id }}"></div>

        {% assign nlc_form_id = 'NeonConfiguratorForm-' | append: section.id %}
        {% form 'contact', id: nlc_form_id, class: 'nlc-form' %}
          <input type="hidden" name="contact[Konfiguration]" id="nlcConfigSummary-{{ section.id }}" value="">
          <input type="hidden" name="contact[Logo]" id="nlcLogoUrl-{{ section.id }}" value="">
          <input type="hidden" name="contact[Betreff]" value="Preisanfrage Neon-Konfigurator">

          {% if form.posted_successfully? %}
            <div class="nlc-success" role="status">
              <strong>Danke!</strong> Deine Preisanfrage ist eingegangen. Du erhältst innerhalb von 24&nbsp;Stunden ein persönliches Angebot per E-Mail &ndash; darin findest du einen Link, über den du direkt online bestellen und bezahlen kannst.
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="nlc-error-box" role="alert">
              <ul>
                {% for field in form.errors %}
                  <li>
                    {% if field == 'form' %}
                      {{ form.errors.messages[field] }}
                    {% else %}
                      {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          <label class="nlc-field" for="nlcName-{{ section.id }}">
            <span class="nlc-label">Name*</span>
            <input required type="text" name="contact[name]" id="nlcName-{{ section.id }}" value="{{ form.name | escape }}" autocomplete="name">
          </label>

          <label class="nlc-field" for="nlcEmail-{{ section.id }}">
            <span class="nlc-label">E-Mail*</span>
            <input required type="email" name="contact[email]" id="nlcEmail-{{ section.id }}" value="{{ form.email | escape }}" autocomplete="email">
          </label>

          <label class="nlc-field" for="nlcPhone-{{ section.id }}">
            <span class="nlc-label">Telefon (optional)</span>
            <input type="tel" name="contact[phone]" id="nlcPhone-{{ section.id }}" value="{{ form.phone | escape }}" autocomplete="tel">
          </label>

          <label class="nlc-field" for="nlcBody-{{ section.id }}">
            <span class="nlc-label">Nachricht (optional)</span>
            <textarea name="contact[body]" id="nlcBody-{{ section.id }}" rows="3" maxlength="500" placeholder="Weitere Wünsche, Maße oder Wunschtermin ...">{{ form.body | escape }}</textarea>
          </label>

          <button type="submit" class="nlc-cta button">Preisanfrage senden</button>
          <p class="nlc-hint">Wir antworten innerhalb von 24 Stunden &ndash; unverbindlich und kostenlos.</p>
        {% endform %}
      </div>
    </div>
  </div>

  <script>
  (function () {
    var section = document.currentScript.closest('.nlc-wrap');
    if (!section) return;
    var stage = section.querySelector('#nlcStage-{{ section.id }}');
    var preview = section.querySelector('#nlcPreview-{{ section.id }}');
    var textInput = section.querySelector('#nlcText-{{ section.id }}');
    var styleButtons = section.querySelectorAll('#nlcStyles-{{ section.id }} .nlc-style');
    var swatches = section.querySelectorAll('#nlcSwatches-{{ section.id }} .nlc-swatch');
    var sizes = section.querySelectorAll('#nlcSizes-{{ section.id }} .nlc-size');
    var customSizeWrap = section.querySelector('#nlcCustomSize-{{ section.id }}');
    var customWidthInput = section.querySelector('#nlcCustomWidth-{{ section.id }}');
    var customSizeBtn = section.querySelector('#nlcSizes-{{ section.id }} [data-custom-size="true"]');
    var backings = section.querySelectorAll('#nlcBackings-{{ section.id }} .nlc-size');
    var scenes = section.querySelectorAll('#nlcScenes-{{ section.id }} .nlc-scene');
    var mounts = section.querySelectorAll('#nlcMounts-{{ section.id }} .nlc-size');
    var envs = section.querySelectorAll('#nlcEnvs-{{ section.id }} .nlc-chip');
    var accessories = section.querySelectorAll('#nlcAccessories-{{ section.id }} .nlc-chip');
    var configSummary = section.querySelector('#nlcConfigSummary-{{ section.id }}');
    var step1 = section.querySelector('#nlcStep1-{{ section.id }}');
    var step2 = section.querySelector('#nlcStep2-{{ section.id }}');
    var nextBtn = section.querySelector('#nlcNextBtn-{{ section.id }}');
    var backBtn = section.querySelector('#nlcBackBtn-{{ section.id }}');
    var stepper = section.querySelector('#nlcStepper-{{ section.id }}');
    var stepAnnounce = section.querySelector('#nlcStepAnnounce-{{ section.id }}');
    var recap = section.querySelector('#nlcRecap-{{ section.id }}');
    var colorNameEl = section.querySelector('#nlcColorName-{{ section.id }}');
    var ambientEl = section.querySelector('#nlcAmbient-{{ section.id }}');
    var logoInput = section.querySelector('#nlcLogoInput-{{ section.id }}');
    var logoUploadStatus = section.querySelector('#nlcUploadStatus-{{ section.id }}');
    var logoUploadThumb = section.querySelector('#nlcUploadThumb-{{ section.id }}');
    var logoUrlField = section.querySelector('#nlcLogoUrl-{{ section.id }}');
    var logoPreviewImg = section.querySelector('#nlcLogoPreview-{{ section.id }}');
    var contactForm = section.querySelector('#{{ nlc_form_id }}');
    var priceEstimateEl = section.querySelector('#nlcPriceEstimate-{{ section.id }}');

    var state = {
      text: textInput.value,
      fontName: 'Retro',
      font: "'Monoton', cursive",
      glow: 0.5,
      colorName: 'Bernstein',
      color: '#ffb340',
      isRgb: false,
      sizeLabel: 'M · ca. 50 cm Breite',
      scale: 1,
      widthCm: 50,
      backing: 'Konturgeschnitten (transparent)',
      backingKey: 'kontur',
      bgName: 'Hecke',
      bg: 'https://cdn.shopify.com/s/files/1/0943/7203/6947/files/hecke-hintergrund.jpg?width=1600',
      mount: 'Wandmontage mit Abstandshaltern',
      env: 'Innen',
      accessory: 'Mit Fernbedienung & Dimmer',
      logoUrl: '',
      logoName: '',
      logoBaseFilter: '',
      hasLogoImage: false
    };

    var CLOUDINARY_CLOUD_NAME = 'e7qq1hun';
    var CLOUDINARY_UPLOAD_PRESET = 'Neonlight';
    var logoUploading = false;

    function selectFromGroup(buttons, activeBtn) {
      buttons.forEach(function (b) {
        b.classList.remove('is-active');
        b.setAttribute('aria-checked', 'false');
        b.setAttribute('tabindex', '-1');
      });
      activeBtn.classList.add('is-active');
      activeBtn.setAttribute('aria-checked', 'true');
      activeBtn.setAttribute('tabindex', '0');
    }

    function initRadiogroup(list) {
      list.forEach(function (btn) {
        btn.setAttribute('tabindex', btn.classList.contains('is-active') ? '0' : '-1');
        btn.addEventListener('keydown', function (e) {
          if (e.key !== 'ArrowRight' && e.key !== 'ArrowDown' && e.key !== 'ArrowLeft' && e.key !== 'ArrowUp') return;
          e.preventDefault();
          var idx = Array.prototype.indexOf.call(list, btn);
          var dir = (e.key === 'ArrowRight' || e.key === 'ArrowDown') ? 1 : -1;
          var next = list[(idx + dir + list.length) % list.length];
          next.focus();
          next.click();
        });
      });
    }

    function hexToRgb(hex) {
      hex = hex.replace('#', '');
      return {
        r: parseInt(hex.substring(0, 2), 16),
        g: parseInt(hex.substring(2, 4), 16),
        b: parseInt(hex.substring(4, 6), 16)
      };
    }

    function rgbToHex(r, g, b) {
      return '#' + [r, g, b].map(function (x) {
        return ('0' + Math.max(0, Math.min(255, x)).toString(16)).slice(-2);
      }).join('');
    }

    function mixWithWhite(hex, amount) {
      var c = hexToRgb(hex);
      var r = Math.round(c.r + (255 - c.r) * amount);
      var g = Math.round(c.g + (255 - c.g) * amount);
      var b = Math.round(c.b + (255 - c.b) * amount);
      return rgbToHex(r, g, b);
    }

    function hexToRgba(hex, alpha) {
      var c = hexToRgb(hex);
      return 'rgba(' + c.r + ',' + c.g + ',' + c.b + ',' + alpha + ')';
    }

    // Richtpreis-Kalkulation auf Basis der LITASIGN-Herstellerkosten (siehe interne
    // Preiskalkulation): Lichtkosten skalieren linear mit der Breite, Rückwand nach
    // Fläche, plus Versand, umgerechnet in CHF mit Marge. Nur eine grobe Schätzung -
    // das verbindliche Angebot kommt per E-Mail.
    var PRICE_LIGHT_USD_PER_CM = 23.1 / 30;
    var PRICE_RGB_SURCHARGE = 0.365;
    var PRICE_ACRYLIC_USD_PER_M2 = 22.7;
    var PRICE_BLACKBOARD_USD_PER_M2 = 7.6;
    var PRICE_HEIGHT_RATIO = 0.30;
    var PRICE_FX_CHF_PER_USD = 0.88;
    var PRICE_MARGIN = 2.8;
    var PRICE_SHIPPING_POINTS = [[30, 45.5], [50, 68.18], [80, 177.0]];

    function estimateShippingUsd(widthCm) {
      var pts = PRICE_SHIPPING_POINTS;
      if (widthCm <= pts[0][0]) { return pts[0][1]; }
      for (var i = 0; i < pts.length - 1; i++) {
        if (widthCm >= pts[i][0] && widthCm <= pts[i + 1][0]) {
          return pts[i][1] + (pts[i + 1][1] - pts[i][1]) * (widthCm - pts[i][0]) / (pts[i + 1][0] - pts[i][0]);
        }
      }
      var x0 = pts[1][0], y0 = pts[1][1], x1 = pts[2][0], y1 = pts[2][1];
      var slope = (y1 - y0) / (x1 - x0);
      return y1 + slope * (widthCm - x1);
    }

    function estimatePriceChf(widthCm, backingKey, isRgb) {
      var light = widthCm * PRICE_LIGHT_USD_PER_CM;
      if (isRgb) { light *= (1 + PRICE_RGB_SURCHARGE); }
      var widthM = widthCm / 100;
      var heightM = widthM * PRICE_HEIGHT_RATIO;
      var area = widthM * heightM;
      var backingCost = 0;
      if (backingKey === 'transparent') { backingCost = area * PRICE_ACRYLIC_USD_PER_M2; }
      else if (backingKey === 'schwarz') { backingCost = area * PRICE_BLACKBOARD_USD_PER_M2; }
      var totalUsd = light + backingCost + estimateShippingUsd(widthCm);
      return totalUsd * PRICE_FX_CHF_PER_USD * PRICE_MARGIN;
    }

    function updatePriceEstimate() {
      if (!priceEstimateEl) { return; }
      if (!state.widthCm || state.widthCm <= 0) {
        priceEstimateEl.textContent = 'Preis nach individueller Anfrage.';
        return;
      }
      var price = estimatePriceChf(state.widthCm, state.backingKey, state.isRgb);
      var rounded = Math.round(price / 5) * 5;
      priceEstimateEl.textContent = 'ca. CHF ' + rounded.toLocaleString('de-CH') + '.– (Richtpreis, verbindliches Angebot per E-Mail)';
    }

    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var rgbRafId = null;
    var rgbStartTime = null;
    var RGB_CYCLE_MS = 6000;

    function stepRgbCycle(timestamp) {
      if (!state.isRgb) { rgbRafId = null; return; }
      if (rgbStartTime === null) { rgbStartTime = timestamp; }
      var elapsed = (timestamp - rgbStartTime) % RGB_CYCLE_MS;
      var hueFilter = 'hue-rotate(' + ((elapsed / RGB_CYCLE_MS) * 360) + 'deg)';
      preview.style.filter = hueFilter;
      if (ambientEl) { ambientEl.style.filter = hueFilter; }
      if (logoPreviewImg && state.hasLogoImage) {
        logoPreviewImg.style.filter = state.logoBaseFilter + ' ' + hueFilter;
      }
      rgbRafId = window.requestAnimationFrame(stepRgbCycle);
    }

    function startRgbCycle() {
      if (reduceMotion || rgbRafId !== null) return;
      rgbStartTime = null;
      rgbRafId = window.requestAnimationFrame(stepRgbCycle);
    }

    function stopRgbCycle() {
      if (rgbRafId !== null) {
        window.cancelAnimationFrame(rgbRafId);
        rgbRafId = null;
      }
      preview.style.filter = '';
      if (ambientEl) { ambientEl.style.filter = ''; }
      if (logoPreviewImg) { logoPreviewImg.style.filter = state.logoBaseFilter; }
    }

    function render() {
      var text = state.text.trim() || 'NEONLIGHT';
      preview.textContent = text;
      preview.style.setProperty('--nlc-color', state.color);
      preview.style.setProperty('--nlc-core-color', mixWithWhite(state.color, 0.6));
      preview.style.setProperty('--nlc-scale', state.scale);
      preview.style.setProperty('--nlc-glow', state.glow);
      preview.style.fontFamily = state.font;
      preview.classList.toggle('is-rgb', state.isRgb);

      state.logoBaseFilter =
        'drop-shadow(0 0 2px ' + mixWithWhite(state.color, 0.6) + ')' +
        ' drop-shadow(0 0 6px ' + state.color + ')' +
        ' drop-shadow(0 0 14px ' + state.color + ')';
      if (logoPreviewImg) {
        logoPreviewImg.style.setProperty('--nlc-scale', state.scale);
        if (!state.isRgb) { logoPreviewImg.style.filter = state.logoBaseFilter; }
        logoPreviewImg.classList.toggle('is-rgb', state.isRgb);
        logoPreviewImg.hidden = !state.hasLogoImage;
      }
      preview.hidden = state.hasLogoImage;
      if (ambientEl) {
        ambientEl.classList.toggle('is-rgb', state.isRgb);
      }
      if (state.isRgb) {
        startRgbCycle();
      } else {
        stopRgbCycle();
      }

      if (colorNameEl) {
        colorNameEl.textContent = state.colorName;
      }

      updatePriceEstimate();
      var priceLine = priceEstimateEl ? priceEstimateEl.textContent : '';

      if (configSummary) {
        configSummary.value =
          'Text: ' + text +
          ' | Stil: ' + state.fontName +
          ' | Farbe: ' + state.colorName +
          ' | Größe: ' + state.sizeLabel +
          ' | Rückwand: ' + state.backing +
          ' | Befestigung: ' + state.mount +
          ' | Einsatzort: ' + state.env +
          ' | Zubehör: ' + state.accessory +
          (state.logoUrl ? ' | Logo: ' + state.logoUrl : '') +
          ' | Vorschau-Hintergrund: ' + state.bgName +
          (priceLine ? ' | Richtpreis (Web-Kalkulation): ' + priceLine : '');
      }

      if (logoUrlField) {
        logoUrlField.value = state.logoUrl;
      }

      if (recap) {
        recap.textContent = '"' + text + '" · ' + state.fontName + ' · ' + state.colorName + ' · ' + state.sizeLabel.split(' ·')[0] + ' · ' + state.backing + ' · ' + state.mount + ' · ' + state.env + ' · ' + state.accessory + (state.logoUrl ? ' · Logo angehängt' : '') + (priceLine ? ' · ' + priceLine : '');
      }
    }

    function uploadLogo(file) {
      var isImage = file.type.indexOf('image/') === 0;
      if (isImage) {
        var objectUrl = URL.createObjectURL(file);
        if (logoUploadThumb) {
          logoUploadThumb.src = objectUrl;
          logoUploadThumb.hidden = false;
        }
        if (logoPreviewImg) {
          logoPreviewImg.src = objectUrl;
        }
        state.hasLogoImage = true;
      }
      state.logoUrl = '';
      state.logoName = file.name;
      logoUploading = true;
      if (logoUploadStatus) {
        logoUploadStatus.textContent = 'Lädt hoch: ' + file.name + ' …';
        logoUploadStatus.classList.remove('is-error', 'is-done');
      }
      render();

      var formData = new FormData();
      formData.append('file', file);
      formData.append('upload_preset', CLOUDINARY_UPLOAD_PRESET);

      fetch('https://api.cloudinary.com/v1_1/' + CLOUDINARY_CLOUD_NAME + '/auto/upload', {
        method: 'POST',
        body: formData
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (!data.secure_url) { throw new Error('no secure_url'); }
          state.logoUrl = data.secure_url;
          logoUploading = false;
          if (logoUploadStatus) {
            logoUploadStatus.textContent = 'Hochgeladen: ' + file.name;
            logoUploadStatus.classList.add('is-done');
          }
          render();
        })
        .catch(function () {
          state.logoUrl = '';
          logoUploading = false;
          if (logoUploadStatus) {
            logoUploadStatus.textContent = 'Upload fehlgeschlagen – bitte erneut versuchen oder Logo per E-Mail nachreichen.';
            logoUploadStatus.classList.add('is-error');
          }
          render();
        });
    }

    var bgFadeTimer = null;

    function updateStageVisual(animate) {
      function apply() {
        if (ambientEl) {
          ambientEl.style.background = 'radial-gradient(circle at 50% 46%, ' + hexToRgba(state.color, 0.3) + ' 0%, ' + hexToRgba(state.color, 0) + ' 26%)';
        }
        if (state.bg) {
          stage.style.backgroundImage = "linear-gradient(rgba(6,7,10,0.62), rgba(6,7,10,0.62)), url('" + state.bg + "')";
          stage.classList.add('has-bg');
        } else {
          stage.style.backgroundImage = 'repeating-linear-gradient(45deg, rgba(255,255,255,0.015) 0 2px, transparent 2px 4px)';
          stage.classList.remove('has-bg');
        }
        stage.style.opacity = '1';
      }
      if (bgFadeTimer) { window.clearTimeout(bgFadeTimer); }
      if (!animate) {
        apply();
        return;
      }
      stage.style.opacity = '0';
      bgFadeTimer = window.setTimeout(apply, 200);
    }

    function goToStep(n) {
      if (n === 2) {
        step1.hidden = true;
        step2.hidden = false;
        stepper.querySelector('[data-step-dot="1"]').classList.add('is-done');
        stepper.querySelector('[data-step-dot="2"]').classList.add('is-active');
        stepper.querySelector('[data-step-dot="1"]').classList.remove('is-active');
        if (stepAnnounce) stepAnnounce.textContent = 'Schritt 2 von 2: Kontaktdaten';
        var heading = step2.querySelector('.nlc-back');
        if (heading) { heading.focus(); }
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        step2.hidden = true;
        step1.hidden = false;
        stepper.querySelector('[data-step-dot="2"]').classList.remove('is-active');
        stepper.querySelector('[data-step-dot="1"]').classList.add('is-active');
        stepper.querySelector('[data-step-dot="1"]').classList.remove('is-done');
        if (stepAnnounce) stepAnnounce.textContent = 'Schritt 1 von 2: Gestalten';
      }
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        render();
        goToStep(2);
      });
    }
    if (backBtn) {
      backBtn.addEventListener('click', function () {
        goToStep(1);
      });
    }

    styleButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        selectFromGroup(styleButtons, btn);
        state.font = btn.dataset.font;
        state.fontName = btn.dataset.name;
        state.glow = parseFloat(btn.dataset.glow) || 1;
        render();
      });
    });

    textInput.addEventListener('input', function () {
      state.text = textInput.value;
      render();
    });

    if (logoInput) {
      logoInput.addEventListener('change', function () {
        var file = logoInput.files && logoInput.files[0];
        if (file) { uploadLogo(file); }
      });
    }

    if (contactForm) {
      contactForm.addEventListener('submit', function (e) {
        if (logoUploading) {
          e.preventDefault();
          if (logoUploadStatus) {
            logoUploadStatus.textContent = 'Logo wird noch hochgeladen – bitte kurz warten und erneut senden.';
            logoUploadStatus.classList.add('is-error');
          }
        }
      });
    }

    swatches.forEach(function (btn) {
      btn.addEventListener('click', function () {
        selectFromGroup(swatches, btn);
        state.color = btn.dataset.color;
        state.colorName = btn.dataset.name;
        state.isRgb = btn.dataset.rgb === 'true';
        render();
        updateStageVisual(false);
      });
    });

    scenes.forEach(function (btn) {
      btn.addEventListener('click', function () {
        selectFromGroup(scenes, btn);
        state.bg = btn.dataset.bg;
        state.bgName = btn.dataset.name;
        updateStageVisual(true);
        render();
      });
    });

    mounts.forEach(function (btn) {
      btn.addEventListener('click', function () {
        selectFromGroup(mounts, btn);
        state.mount = btn.dataset.mount;
        render();
      });
    });

    envs.forEach(function (btn) {
      btn.addEventListener('click', function () {
        selectFromGroup(envs, btn);
        state.env = btn.dataset.env;
        render();
      });
    });

    accessories.forEach(function (btn) {
      btn.addEventListener('click', function () {
        selectFromGroup(accessories, btn);
        state.accessory = btn.dataset.accessory;
        render();
      });
    });

    function applyCustomSize() {
      var width = parseFloat(customWidthInput.value);
      if (width && width > 0) {
        width = Math.min(300, Math.max(10, Math.round(width)));
        state.sizeLabel = 'Eigene Masse · ' + width + ' cm Breite';
        state.scale = Math.min(3, Math.max(0.5, width / 50));
        state.widthCm = width;
      } else {
        state.sizeLabel = 'Eigene Masse (Breite folgt im Gespräch)';
        state.widthCm = 0;
      }
    }

    sizes.forEach(function (btn) {
      btn.addEventListener('click', function () {
        selectFromGroup(sizes, btn);
        if (btn.dataset.customSize === 'true') {
          if (customSizeWrap) { customSizeWrap.hidden = false; }
          applyCustomSize();
          render();
          if (customWidthInput) { customWidthInput.focus(); }
        } else {
          if (customSizeWrap) { customSizeWrap.hidden = true; }
          state.sizeLabel = btn.dataset.size;
          state.scale = parseFloat(btn.dataset.scale);
          state.widthCm = parseFloat(btn.dataset.width);
          render();
        }
      });
    });

    if (customWidthInput) {
      customWidthInput.addEventListener('input', function () {
        if (customSizeBtn && !customSizeBtn.classList.contains('is-active')) {
          selectFromGroup(sizes, customSizeBtn);
        }
        applyCustomSize();
        render();
      });
    }

    backings.forEach(function (btn) {
      btn.addEventListener('click', function () {
        selectFromGroup(backings, btn);
        state.backing = btn.dataset.backing;
        state.backingKey = btn.dataset.backingKey;
        render();
      });
    });

    initRadiogroup(styleButtons);
    initRadiogroup(swatches);
    initRadiogroup(sizes);
    initRadiogroup(backings);
    initRadiogroup(scenes);
    initRadiogroup(mounts);
    initRadiogroup(envs);
    initRadiogroup(accessories);

    render();
    updateStageVisual(false);

    var startStep = parseInt(section.dataset.startStep, 10) || 1;
    if (startStep === 2) {
      goToStep(2);
    } else {
      stepper.querySelector('[data-step-dot="1"]').classList.add('is-active');
    }

    var feedback = section.querySelector('.nlc-success, .nlc-error-box');
    if (feedback) {
      feedback.setAttribute('tabindex', '-1');
      feedback.focus();
      feedback.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  })();
  </script>
</div>
