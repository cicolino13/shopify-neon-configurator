{%- style -%}
  #shopify-section-{{ section.id }} .hf-hero {
    position: relative;
    overflow: hidden;
    background: #05060C;
    color: #F2F4FF;
  }
  #shopify-section-{{ section.id }} .hf-hero__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 15% 8%, rgba(122,90,255,0.18), transparent 40%),
      radial-gradient(circle at 85% 25%, rgba(63,224,230,0.16), transparent 40%);
    z-index: 1;
  }
  #shopify-section-{{ section.id }} .hf-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    opacity: 0.5;
  }
  #shopify-section-{{ section.id }} .hf-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(5,6,12,0.55), rgba(5,6,12,0.95));
    z-index: 1;
  }
  #shopify-section-{{ section.id }} .hf-hero__inner {
    position: relative;
    z-index: 2;
    max-width: 1400px;
    margin: 0 auto;
    padding: 90px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 56px;
  }
  #shopify-section-{{ section.id }} .hf-hero__content {
    max-width: 620px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  #shopify-section-{{ section.id }} .hf-eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #B39BFF;
  }
  #shopify-section-{{ section.id }} .hf-heading {
    margin: 0;
    font-family: 'Orbitron', sans-serif;
    text-transform: uppercase;
    font-weight: 700;
    font-size: clamp(2.8rem, 5vw, 5rem);
    line-height: 1.15;
    text-wrap: pretty;
    background: linear-gradient(90deg, #B39BFF, #3FE0E6);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  #shopify-section-{{ section.id }} .hf-sub {
    margin: 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 1.5rem;
    line-height: 1.7;
    color: #A9B0CE;
  }
  #shopify-section-{{ section.id }} .hf-actions {
    display: flex;
    gap: 18px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 6px;
  }
  #shopify-section-{{ section.id }} .hf-btn {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.2);
    color: #F2F4FF;
    padding: 15px 28px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 1.3rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: 8px;
    text-decoration: none;
    display: inline-block;
  }
  #shopify-section-{{ section.id }} .hf-btn:hover { background: rgba(255,255,255,0.12); }
  #shopify-section-{{ section.id }} .hf-link {
    color: #3FE0E6;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 1.3rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .hf-panel {
    flex: none;
    width: 340px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: relative;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 16px;
  }
  #shopify-section-{{ section.id }} .hf-panel__row {
    display: flex;
    justify-content: space-between;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #8891B0;
  }
  #shopify-section-{{ section.id }} .hf-panel__row span:last-child { color: #F2F4FF; }
  #shopify-section-{{ section.id }} .hf-panel__row.is-accent span:last-child { color: #3FE0E6; }
  #shopify-section-{{ section.id }} .hf-panel__row.is-ok span:last-child { color: #8CFFB0; }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .hf-hero__inner {
      flex-direction: column;
      align-items: stretch;
      padding: 56px 24px;
      gap: 32px;
    }
    #shopify-section-{{ section.id }} .hf-panel { width: 100%; }
  }
{%- endstyle -%}

<div class="hf-hero">
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 1600 | image_tag: class: 'hf-hero__img', loading: 'eager', widths: '750, 1100, 1600' }}
  {%- endif -%}
  <div class="hf-hero__scrim"></div>
  <div class="hf-hero__glow"></div>
  <div class="hf-hero__inner">
    <div class="hf-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="hf-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h1 class="hf-heading">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="hf-sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      <div class="hf-actions">
        {%- if section.settings.button_label_1 != blank -%}
          <a href="{{ section.settings.button_link_1 }}" class="hf-btn">{{ section.settings.button_label_1 | escape }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 }}" class="hf-link">{{ section.settings.button_label_2 | escape }} →</a>
        {%- endif -%}
      </div>
    </div>
    <div class="hf-panel">
      <div class="hf-panel__row"><span>Farbe</span><span>Cyan #3FD7E0</span></div>
      <div class="hf-panel__row"><span>Grösse</span><span>M · 50 cm</span></div>
      <div class="hf-panel__row is-ok"><span>Status</span><span>Bereit</span></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero (Futuristisch)",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hintergrundbild" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "System: neon.os" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Licht-Konfiguration in Echtzeit" },
    { "type": "textarea", "id": "subheading", "label": "Untertitel", "default": "Wähle Text, Farbe und Grösse – dein Neon-Sign entsteht live, bereit für Zuhause oder Storefront." },
    { "type": "text", "id": "button_label_1", "label": "Button-Text", "default": "Konfigurator starten" },
    { "type": "url", "id": "button_link_1", "label": "Button-Link" },
    { "type": "text", "id": "button_label_2", "label": "Link-Text (sekundär)", "default": "Spezifikationen ansehen" },
    { "type": "url", "id": "button_link_2", "label": "Link (sekundär)" }
  ],
  "presets": [{ "name": "Hero (Futuristisch)" }]
}
{% endschema %}
